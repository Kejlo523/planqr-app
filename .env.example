# Zastąp wartości example własnymi sekretami w lokalnym pliku .env.
# Tryb pracy aplikacji: development, production albo test.
NODE_ENV=development

# Integracja czytnika. W trybie attendance podaj granicę UTC dla nowych odbić.
KANTECH_MODE=off
KANTECH_DEV_TOOLS=false
KANTECH_ACTIVE_FROM=
KANTECH_URL=
KANTECH_USER=
KANTECH_PASS=examplePassword
# Opcjonalna lista ID importowana raz, gdy w bazie nie ma jeszcze czytników.
KANTECH_DOOR_IDS=49919
WORKER_SECRET_TOKEN=exampleWorkerToken

# =========================
# Backend
# =========================

# Port backendu wystawiany przez Docker Compose.
PORT=9099

# true = backend działa po HTTP, false = backend próbuje uruchomić HTTPS z certyfikatami z katalogu /certs.
DISABLE_HTTPS=true

# Publiczny adres backendu używany m.in. w logach i Swaggerze.
# Uwaga: nie dopisuj tutaj /api, bo endpointy mają już ten prefiks w aplikacji.
BACKEND_PUBLIC_URL=http://localhost:9099

# Lista dozwolonych originów CORS oddzielona przecinkami.
CORS_ORIGIN=https://localhost:3000,http://localhost:3000,https://localhost

# Pełny connection string do PostgreSQL używany przez Prisma i backend.
DATABASE_URL=postgresql://zut:examplePassword@localhost:5432/planqr-db-prod?schema=public

# Sekret do podpisywania i weryfikacji tokenów JWT.
JWT_SECRET=exampleJwtSecret
# ROOT_ADMIN_LOGIN=exampleAdmin
# ROOT_ADMIN_PASSWORD=examplePassword

# Adres serwera LDAP.
LDAP_URL=ldap://ldap.zut.edu.pl

# Wzorzec DN dla logowania do LDAP. %s zostanie podmienione na login użytkownika.
LDAP_DN=uid=%s,cn=users,cn=accounts,dc=zut,dc=edu,dc=pl

# Zewnętrzny endpoint planu zajęć używany przez backend do pobierania harmonogramu.
ZUT_SCHEDULE_STUDENT_URL=https://plan.zut.edu.pl/schedule_student.php
ZUT_ATTENDANCE_SCHEDULE_URL=

# =========================
# Frontend
# =========================

# Port hosta, pod którym Docker wystawia frontend (nginx).
FRONTEND_PORT=443

# Port używany lokalnie przez Vite w trybie developerskim.
FRONTEND_DEV_PORT=3000

# Publiczny adres frontendu widoczny dla użytkowników i przeglądarki.
FRONTEND_PUBLIC_URL=https://localhost:3000

# Wewnętrzny adres backendu widoczny z kontenera frontendu.
BACKEND_INTERNAL_URL=http://backend:9099

# Zewnętrzny endpoint wyszukiwania sal, proxowany przez frontend.
ZUT_SCHEDULE_URL=https://plan.zut.edu.pl/schedule.php

# Bazowy adres plan.zut.edu.pl używany np. do generowania linków i kodów QR.
ZUT_PLAN_BASE_URL=https://plan.zut.edu.pl
